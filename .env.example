# Copy to .env and adjust. Never commit .env.
# All values below are the development defaults.

# LM Studio (OpenAI-compatible) — Mac Studio over Tailscale
LLM_BASE_URL=http://earnests-mac-studio.taila366aa.ts.net:1234/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_S=30

# Service
BIND_HOST=127.0.0.1
BIND_PORT=8080
LOG_LEVEL=INFO

# Security posture (Phase 0 default)
ENABLE_TAILSCALE_ONLY=true
SESSION_TTL_HOURS=24
PII_REDACT_AT_INGRESS=true
