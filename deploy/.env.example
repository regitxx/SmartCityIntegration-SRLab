# smcity Mac Studio deploy — copy to .env and fill in.
#
# .env is gitignored. NEVER commit a real auth key or API key.

# ---- Tailscale sidecar ----------------------------------------------------
# One-time auth key from https://login.tailscale.com/admin/settings/keys
# Recommended: Reusable=NO, Ephemeral=NO, Tags=tag:server.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Hostname the sidecar will register as on the tailnet. The container will
# be reachable at https://<TS_HOSTNAME>.<your-tailnet>.ts.net/
TS_HOSTNAME=smcity

# ---- Phoenix Arize tracing -----------------------------------------------
# OTLP collector + project. If PHOENIX_COLLECTOR_ENDPOINT is empty the agent
# falls back to a no-op exporter (spans are still produced in-process; nothing
# is sent over the network).
#
# Endpoint is the BASE URL only — the agent appends /v1/traces itself.
PHOENIX_COLLECTOR_ENDPOINT=https://phoenix.sustainer.ai
# Project API key generated in the Phoenix UI (Settings → Keys).
PHOENIX_API_KEY=REPLACE_ME
# Phoenix project name — spans land in this bucket.
PHOENIX_PROJECT_NAME=smcity
