# smcity Mac Studio deploy — copy to .env and fill in.
#
# .env is gitignored. NEVER commit a real auth key.

# Tailscale auth key (one-time use; create at
# https://login.tailscale.com/admin/settings/keys).
# Recommended settings on the key:
#   - Reusable: NO  (use a fresh key per deploy)
#   - Ephemeral: NO (the node should persist)
#   - Tags: tag:server  (or whatever your ACL uses)
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Hostname the sidecar will register as on the tailnet. The container will
# be reachable at https://<TS_HOSTNAME>.<your-tailnet>.ts.net/
TS_HOSTNAME=smcity
